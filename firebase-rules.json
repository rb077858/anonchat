{
  "rules": {
    ".read": false,
    ".write": false,

    "ids": {
      "$id": {
        ".read": true,
        ".write": "auth != null && $id.matches(/^[0-9]{6}$/) && ((!data.exists() && newData.val() === auth.uid && (auth.uid === 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2' || newData.parent().parent().child('owners').child(auth.uid).child('id').val() === $id)) || (data.val() === auth.uid && !newData.exists()))"
      }
    },

    "owners": {
      "$ownerUid": {
        ".read": "auth != null && auth.uid === $ownerUid",
        "id": {
          ".write": "auth != null && auth.uid === $ownerUid",
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/) && newData.parent().parent().parent().child('ids').child(newData.val()).val() === auth.uid && (!data.exists() || data.val() === newData.val() || newData.parent().parent().parent().child('ids').child(data.val()).val() !== auth.uid)"
        },
        "deviceId": {
          ".write": "auth != null && auth.uid === $ownerUid && !data.exists()",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "$other": { ".validate": false }
      }
    },

    "users": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && $uid.matches(/^[0-9]{6}$/) && root.child('ids').child($uid).val() === auth.uid",

        "online":   { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "status":   { ".validate": "newData.isString() && newData.val().length < 20" },

        "invites": {
          "$roomId": {
            ".write": "auth != null && (newData.exists() ? (newData.child('from').val() !== $uid && root.child('ids').child(newData.child('from').val()).val() === auth.uid) : (root.child('ids').child($uid).val() === auth.uid || root.child('ids').child(data.child('from').val()).val() === auth.uid))",
            ".validate": "newData.hasChildren(['from','fromDevice','timestamp'])",
            "from": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)"
            },
            "fromDevice": {
              ".validate": "newData.isString() && (auth.uid === 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2' || root.child('owners').child(auth.uid).child('deviceId').val() === newData.val()) && root.child('blocklist').child(newData.val()).child('blocked').val() != true"
            },
            "timestamp": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    },

    "matchmaking": {
      "waiting": {
        ".read": true,
        ".write": "auth != null && (!newData.exists() || !data.exists() || data.child('id').val() === newData.child('id').val())",
        ".validate": "newData.hasChildren(['id','roomId','deviceId']) && newData.child('id').isString() && root.child('ids').child(newData.child('id').val()).val() === auth.uid && newData.child('deviceId').isString() && (auth.uid === 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2' || root.child('owners').child(auth.uid).child('deviceId').val() === newData.child('deviceId').val()) && root.child('blocklist').child(newData.child('deviceId').val()).child('blocked').val() != true"
      }
    },

    "rooms": {
      "$roomId": {
        ".read": true,
        ".write": "auth != null && !newData.exists() && !data.child('participants').exists()",

        "participants": {
          "$uid": {
            ".write": "auth != null && root.child('ids').child($uid).val() === auth.uid",
            ".validate": "newData.hasChildren(['deviceId','joinedAt']) && root.child('blocklist').child(newData.child('deviceId').val()).child('blocked').val() != true",
            "deviceId": { ".validate": "newData.isString() && (auth.uid === 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2' || root.child('owners').child(auth.uid).child('deviceId').val() === newData.val())" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other":   { ".validate": false }
          }
        },

        "messages": {
          "$msgId": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.hasChildren(['sender','senderDevice','text','timestamp']) && root.child('rooms').child($roomId).child('participants').child(newData.child('sender').val()).exists() && root.child('blocklist').child(newData.child('senderDevice').val()).child('blocked').val() != true",
            "sender":       { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/) && root.child('ids').child(newData.val()).val() === auth.uid" },
            "senderDevice": { ".validate": "newData.isString() && (auth.uid === 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2' || root.child('owners').child(auth.uid).child('deviceId').val() === newData.val())" },
            "text":         { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
            "timestamp":    { ".validate": "newData.isNumber()" },
            "$other":       { ".validate": false }
          }
        },

        "typing": {
          "$uid": {
            ".write": "auth != null && root.child('ids').child($uid).val() === auth.uid",
            ".validate": "newData.isBoolean()"
          }
        },

        "declined": { ".write": "auth != null", ".validate": "newData.isBoolean()" },
        "canceled": { ".write": "auth != null", ".validate": "newData.isBoolean()" },
        "reported": { ".write": "auth != null", ".validate": "newData.isBoolean()" },
        "adminRevealed": {
          ".write": "auth != null && auth.uid == 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2'",
          ".validate": "newData.isBoolean()"
        },
        "adminBlockedPeer": {
          ".write": "auth != null && auth.uid == 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2'",
          ".validate": "newData.isBoolean()"
        },
        "$other": { ".validate": false }
      }
    },

    "reports": {
      ".read": "auth != null && auth.uid == 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2'",
      ".indexOn": ["status", "timestamp"],
      "$reportId": {
        ".write": "auth != null && (auth.uid == 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2' || !data.exists())",
        ".validate": "newData.hasChildren(['roomId','reporterId','reporterDevice','reportedId','reportedDevice','timestamp','status']) && (auth.uid == 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2' || (root.child('ids').child(newData.child('reporterId').val()).val() === auth.uid && newData.child('status').val() === 'pending'))",
        "roomId":         { ".validate": "newData.isString()" },
        "reporterId":     { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)" },
        "reporterDevice": { ".validate": "newData.isString()" },
        "reportedId":     { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)" },
        "reportedDevice": { ".validate": "newData.isString()" },
        "timestamp":      { ".validate": "newData.isNumber()" },
        "status":         { ".validate": "newData.isString()" },
        "messages":       { ".validate": true },
        "resolution":     { ".validate": true },
        "$other":         { ".validate": false }
      }
    },

    "blocklist": {
      ".read": "auth != null && auth.uid == 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2'",
      "$deviceId": {
        ".read": true,
        ".write": "auth != null && auth.uid == 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2'",
        ".validate": "newData.hasChildren(['blocked'])",
        "blocked":         { ".validate": "newData.isBoolean()" },
        "reason":          { ".validate": "newData.isString() && newData.val().length <= 500" },
        "blockedAt":       { ".validate": "newData.isNumber()" },
        "canMessageAdmin": { ".validate": "newData.isBoolean()" }
      }
    },

    "adminChats": {
      "$deviceId": {
        ".read": "auth != null && (auth.uid == 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2' || root.child('owners').child(auth.uid).child('deviceId').val() === $deviceId)",
        "messages": {
          "$msgId": {
            ".write": "auth != null && !data.exists() && (auth.uid == 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2' || root.child('owners').child(auth.uid).child('deviceId').val() === $deviceId)",
            ".validate": "newData.hasChildren(['sender','text','timestamp']) && (newData.child('sender').val() == 'user' ? (auth.uid != 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2' && root.child('blocklist').child($deviceId).child('canMessageAdmin').val() != false) : (newData.child('sender').val() == 'admin' && auth.uid == 'q5nzb7TJ3eNw8TXFdidlHb3lwNQ2'))",
            "sender":    { ".validate": "newData.isString()" },
            "text":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
            "timestamp": { ".validate": "newData.isNumber()" },
            "$other":    { ".validate": false }
          }
        }
      }
    }
  }
}
